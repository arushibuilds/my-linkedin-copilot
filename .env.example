# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required: the password that unlocks your workspace
APP_PASSWORD=change-me

# Required: a long random string used to sign the session cookie
# e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Optional: where the SQLite database lives (default: ./data/copilot.db)
# DATABASE_PATH=./data/copilot.db

# Optional: model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
